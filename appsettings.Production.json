{
    "Logging": {
        "LogLevel": {
          "Default": "Warning",
          "Microsoft.AspNetCore": "Error",
          "Microsoft.EntityFrameworkCore.Database.Command": "Error"
        }
      },
    "ConnectionStrings": {
      "DefaultConnection": "Data Source=/app/data/myshop.db"
    },
    "AllowedHosts": "*",
    "Jwt": {
      "Key": "${JWT_SECRET}",
      "Issuer": "MyShopAPI",
      "Audience": "MyShopAPI"
    },
    "Razorpay": {
      "KeyId": "${RAZORPAY_KEY_ID}",
      "KeySecret": "${RAZORPAY_KEY_SECRET}",
      "Currency": "INR"
    },
    "Email": {
      "SmtpHost": "smtp.gmail.com",
      "SmtpPort": 587,
      "SenderEmail": "${EMAIL_SENDER}",
      "SenderName": "MyShop India",
      "Username": "${EMAIL_USERNAME}",
      "Password": "${EMAIL_PASSWORD}"
    },
    "FileStorage": {
        "UploadPath": "/app/wwwroot/uploads/products",
        "MaxFileSizeInMb": 5,
        "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
    }
  }